# Never commit real credentials. Copy to .env on the VPS and protect file permissions.
WALLEX_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

APP_ENV=competition
MODE=shadow
LIVE_TRADING_ENABLED=false
# Keep false until original source materials, API permissions, denylist, and stop execution policy pass preflight.
LIVE_PREFLIGHT_ACKNOWLEDGED=false

# Path to exact denylist extracted from assets.md and reviewed by a human.
MARKET_DENYLIST_PATH=config/market_denylist.txt

# Start values for simulation and review; these are suggestions, not organizer rules.
RISK_PER_TRADE_EQUITY_PCT=0.005
MAX_POSITION_NOTIONAL_EQUITY_PCT=0.15
MAX_TOTAL_EXPOSURE_EQUITY_PCT=0.40
MAX_OPEN_POSITIONS=3
MIN_CASH_RESERVE_EQUITY_PCT=0.50
MAX_DAILY_DRAWDOWN_EQUITY_PCT=0.025
MAX_RUN_DRAWDOWN_EQUITY_PCT=0.05

# Runtime cadence (initial hypotheses; validate against Wallex rate limits and LLM latency)
MARKET_UNIVERSE_REFRESH_SECONDS=900
MARKET_SUMMARY_REFRESH_SECONDS=30
SCAN_INTERVAL_SECONDS=15
AI_REVIEW_MIN_INTERVAL_SECONDS=30
AI_MAX_CALLS_PER_MINUTE=3
MAX_AI_CANDIDATES_PER_CYCLE=3
ORDER_RECONCILE_INTERVAL_SECONDS=5
ACCOUNT_RECONCILE_INTERVAL_SECONDS=30
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
# Separate freshness limits: scanner ranking may use cached snapshots, execution must re-fetch a fresh quote.
MAX_CANDIDATE_DATA_AGE_SECONDS=45
MAX_EXECUTION_QUOTE_AGE_SECONDS=5
# Legacy fallback only; new code should use the two distinct variables above.
MAX_DATA_AGE_SECONDS=15
DATABASE_URL=sqlite:///./data/wallex_agent.db
LOG_LEVEL=INFO
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_ACCESS_TOKEN=
